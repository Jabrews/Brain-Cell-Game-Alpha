shader_parameter/shimmer_strength = 0.0650000030875
shader_parameter/scanline_strength = 0.0
shader_parameter/scanline_density = 3.8390001348525
shader_parameter/hologram_tint = Color(0.89166665, 1, 0.75, 1)

