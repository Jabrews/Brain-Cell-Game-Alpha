[sub_resource type="Shader" id="Shader_3movu"]
code = "shader_type canvas_item;

uniform float stat_defect_value : hint_range(0.0, 1.0);
uniform float start_value : hint_range(0.0, 1.0);

uniform vec4 defect_color : source_color = vec4(0.5, 0.0, 0.0, 1.0);

uniform vec4 increase_color : source_color = vec4(1.0, 0.2, 0.2, 1.0);
uniform vec4 decrease_color : source_color = vec4(0.2, 0.8, 1.0, 1.0);

uniform float overlay_opacity : hint_range(0.0, 1.0) = 0.7;
uniform float stripe_width : hint_range(0.01, 0.5) = 0.08;
uniform float stripe_speed : hint_range(0.1, 5.0) = 0.5;

// Keeps shader from coloring the white/empty edge pixels.
uniform float edge_padding : hint_range(0.0, 20.0) = 0.0;

void fragment() {

	vec4 tex = texture(TEXTURE, UV);

	float tex_width = float(textureSize(TEXTURE, 0).x);
	float pixel_x = UV.x * tex_width;

	bool inside_edges =
		pixel_x >= edge_padding &&
		pixel_x <= (tex_width - edge_padding);

	vec4 result = tex;

	if (inside_edges && tex.a > 0.0) {

		// Base defect bar
		if (UV.x <= stat_defect_value) {
			result = vec4(defect_color.rgb, tex.a);
		}

		// Change stripe
		float left = min(start_value, stat_defect_value);
		float right = max(start_value, stat_defect_value);

		if (
			right - left > 0.001 &&
			UV.x >= left &&
			UV.x <= right
		) {

			float region_uv = (UV.x - left) / (right - left);

			vec4 overlay_color;
			float stripe_pos;

			if (stat_defect_value > start_value) {
				// Defect increased -> red stripe moves right
				overlay_color = increase_color;
				stripe_pos = fract(TIME * stripe_speed);
			}
			else {
				// Defect decreased -> blue stripe moves left
				overlay_color = decrease_color;
				stripe_pos = 1.0 - fract(TIME * stripe_speed);
			}

			float stripe =
				smoothstep(
					stripe_pos - stripe_width,
					stripe_pos,
					region_uv
				)
				*
				(
					1.0
					-
					smoothstep(
						stripe_pos,
						stripe_pos + stripe_width,
						region_uv
					)
				);

			result.rgb = mix(
				result.rgb,
				overlay_color.rgb,
				stripe * overlay_opacity
			);
		}
	}

	COLOR = result;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_4mres"]
shader = SubResource("Shader_3movu")
shader_parameter/stat_defect_value = 0.0
shader_parameter/start_value = 0.0
shader_parameter/defect_color = Color(0.5, 0, 0, 1)
shader_parameter/increase_color = Color(1, 0.2, 0.2, 1)
shader_parameter/decrease_color = Color(0.2, 0.8, 1, 1)
shader_parameter/overlay_opacity = 0.2490000118275
shader_parameter/stripe_width = 0.10000000405148
shader_parameter/stripe_speed = 1.00000004424012
shader_parameter/edge_padding = 2.6370001252575

[sub_resource type="CompressedTexture2D" id="CompressedTexture2D_8udft"]
load_path = "res://.godot/imported/progress_bar_under.png-e57f123632c318b1d08ae788f52e6ada.ctex"

[sub_resource type="Shader" id="Shader_3tyvt"]
code = "shader_type canvas_item;

uniform float prisoner_value : hint_range(0.0, 1.0);
uniform float start_value : hint_range(0.0, 1.0);

uniform vec4 yellow_color : source_color = vec4(1.0, 1.0, 0.0, 1.0);

uniform vec4 increase_color : source_color = vec4(0.2, 0.8, 1.0, 1.0);
uniform vec4 decrease_color : source_color = vec4(1.0, 0.2, 0.2, 1.0);

uniform float overlay_opacity : hint_range(0.0, 1.0) = 0.7;
uniform float stripe_width : hint_range(0.01, 0.5) = 0.08;
uniform float stripe_speed : hint_range(0.1, 5.0) = 0.5;

// keeps shader from coloring the white/empty edge pixels.
uniform float edge_padding : hint_range(0.0, 20.0) = 0.0;

void fragment() {

	vec4 tex = texture(TEXTURE, UV);

	float tex_width = float(textureSize(TEXTURE, 0).x);
	float pixel_x = UV.x * tex_width;

	bool inside_edges =
		pixel_x >= edge_padding &&
		pixel_x <= (tex_width - edge_padding);

	float in_yellow = step(UV.x, prisoner_value);

	vec4 result = tex;

	if (inside_edges && tex.a > 0.0) {

		// prisoner bar
		if (in_yellow > 0.5) {
			result = vec4(yellow_color.rgb, tex.a);
		}

		// change stripe
		float left = min(start_value, prisoner_value);
		float right = max(start_value, prisoner_value);

		if (
			right - left > 0.001 &&
			UV.x >= left &&
			UV.x <= right
		) {

			float region_uv = (UV.x - left) / (right - left);

			vec4 overlay_color;
			float stripe_pos;

			if (prisoner_value > start_value) {
				// increase -> blue -> move right
				overlay_color = increase_color;
				stripe_pos = fract(TIME * stripe_speed);
			}
			else {
				// decrease -> red -> move left
				overlay_color = decrease_color;
				stripe_pos = 1.0 - fract(TIME * stripe_speed);
			}

			float stripe =
				smoothstep(
					stripe_pos - stripe_width,
					stripe_pos,
					region_uv
				)
				*
				(
					1.0
					-
					smoothstep(
						stripe_pos,
						stripe_pos + stripe_width,
						region_uv
					)
				);

			result.rgb = mix(
				result.rgb,
				overlay_color.rgb,
				stripe * overlay_opacity
			);
		}
	}

	COLOR = result;
}"

