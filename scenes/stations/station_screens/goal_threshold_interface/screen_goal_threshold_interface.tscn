		// -------------------------
		// RED BAR
		// -------------------------

		if (UV.x <= red_value) {
			result = vec4(red_color.rgb, tex.a);
		}


		// -------------------------
		// YELLOW BAR
		// starts at red_value
		// and extends left
		// -------------------------

		float yellow_start = max(
			red_value - yellow_value,
			0.0
		);

		bool in_yellow =
			UV.x >= yellow_start &&
